{
  "services": {
    "frontend": {
      "cwd": "./frontend",
      "cmd": "npx",
      "args": [
        "next",
        "dev",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    "backend": {
      "cwd": "./backend",
      "cmd": "./mvnw",
      "args": [
        "spring-boot:run",
        "-Dspring-boot.run.arguments=--server.port=8080"
      ],
      "port": 8080,
      "healthCheck": {
        "path": "/actuator/health",
        "timeoutSeconds": 180
      }
    }
  },
  "routes": {
    "/api": {
      "service": "backend",
      "stripPrefix": false
    },
    "/actuator": {
      "service": "backend",
      "stripPrefix": false
    },
    "/": {
      "service": "frontend",
      "stripPrefix": false
    }
  }
}
